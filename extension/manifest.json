{
  "manifest_version": 3,
  "name": "BookMarkSync · 本地书签同步",
  "version": "1.0.1",
  "description": "通过你选择的本地文件夹，在 Chrome 和 Edge 之间自动双向同步书签，无中介服务器。",
  "minimum_chrome_version": "122",
  "permissions": [
    "bookmarks",
    "alarms",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "BookMarkSync · 设置与状态"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; base-uri 'none'; frame-src 'none'"
  },
  "key": ""
}
